# AI Travel Planner - Environment Variables
# Copy this file to .env and fill in your actual values

# ===========================================
# BACKEND CONFIGURATION
# ===========================================

# Groq API Key (Required for AI Chat Assistant and Itinerary Generation)
# Get your key from: https://console.groq.com/
GROQ_API_KEY=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

# Firebase Admin Configuration (Backend)
# Option 1: Use credentials file path
FIREBASE_CREDENTIALS_PATH=path/to/firebase-credentials.json

# Option 2: Use individual values (if not using credentials file)
FIREBASE_PROJECT_ID=tripplanner-aa906
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Debug Mode (set to true for development)
DEBUG=true

# ===========================================
# FRONTEND CONFIGURATION (Vite)
# ===========================================

# Firebase Client Configuration
# Get these from Firebase Console > Project Settings > Web App
VITE_FIREBASE_API_KEY=AIzaSyB2Yna1vgl-NQXibWZ62asifmBVFc7bJK0
VITE_FIREBASE_AUTH_DOMAIN=tripplanner-aa906.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tripplanner-aa906
VITE_FIREBASE_STORAGE_BUCKET=tripplanner-aa906.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=670791968416
VITE_FIREBASE_APP_ID=1:670791968416:web:d4ccb842756b4098e4cbc5

# Geoapify API Key (Frontend Maps)
# Default key included for your convenience
VITE_GEOAPIFY_API_KEY=4d5816d856ed45c295789e4e00fb8509

# API URL (Backend URL - optional, defaults to /api with proxy)
VITE_API_URL=/api

# ===========================================
# SETUP INSTRUCTIONS
# ===========================================
# 
# 1. Firebase Setup:
#    - Go to https://console.firebase.google.com/
#    - Create a new project or select existing
#    - Enable Authentication (Email/Password)
#    - Enable Cloud Firestore
#    - Create a Web App and copy config values
#    - Go to Project Settings > Service Accounts
#    - Generate new private key for backend
#
# 2. Maps (Geoapify):
#    - Uses a free key out of the box. Optionally get a new one:
#    - Go to https://www.geoapify.com/
#    - Create an API key
#
# 4. Running the Application:
#    
#    Backend:
#    cd backend
#    pip install -r requirements.txt
#    uvicorn app.main:app --reload
#
#    Frontend:
#    cd frontend
#    npm install
#    npm run dev
